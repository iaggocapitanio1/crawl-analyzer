.git
.gitignore

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtualenvs (if anyone built one locally)
venv/
.venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Test and coverage artifacts
.pytest_cache/
.coverage
.tox/
htmlcov/

# Local-only overrides (never bake into the image)
docker-compose.override.yml
.env.local
.env.*.local

# Exports produced at runtime by the export job
exports/

# Macs
.DS_Store
